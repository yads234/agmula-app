<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/cropNameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter crop name" />

    <EditText
        android:id="@+id/plantingDateEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter planting date (yyyy-MM-dd)"
        android:inputType="date" />

    <EditText
        android:id="@+id/harvestDaysEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Estimated harvest duration (days)" />

    <Button
        android:id="@+id/saveEventButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Event" />
</LinearLayout>
